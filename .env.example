# ============================================================
#  Variables de entorno — COPIA a .env.local y llena los valores.
#  NUNCA subir .env.local ni credenciales reales al repo.
# ============================================================

# ── Salesforce (login SOAP: usuario + contraseña + token) ──
SF_USERNAME=tu_usuario@etb.com.co
SF_PASSWORD=tu_contraseña
SF_TOKEN=tu_token_de_seguridad
SF_DOMAIN=login

# Nombres de campo API en Salesforce (ajústalos a los reales sin tocar código)
SF_NIT_FIELD=AccountNumber__c            # campo NIT en el Caso ("Nit Cliente")
SF_RECORD_TYPE=SOPORTE TECNICO           # Tipo de registro del caso (solo soporte)
SF_CITY_FIELD=Ciudad_Instalacion__c      # ciudad del caso (para el mapa)
# Si la ciudad es un lookup, el campo directo devuelve el Id (a014...) y el mapa
# no ubica nada. Con este campo pedimos el nombre legible por la relación.
# Se autodetecta desde SF_CITY_FIELD (…__c → …__r.Name). Déjalo vacío si la
# ciudad ya es un campo de texto.
SF_CITY_NAME_FIELD=Ciudad_Instalacion__r.Name
SF_STATE_FIELD=                          # departamento (opcional, si existe)
# Dirección del caso. Se usa SOLO para geolocalizar: se cruza el texto con las
# localidades de Bogotá y las ciudades (como el script de GAS). No se guarda
# crudo. Útil cuando la ciudad no coincide con el catálogo pero la dirección sí
# menciona la localidad/ciudad. Déjalo vacío si no aplica.
SF_ADDRESS_FIELD=                        # ej. Direccion_Instalacion__c
SF_WINDOW_DAYS=60                        # ventana de casos cerrados a traer
# ¿No sabes los nombres exactos? Llama GET /api/sf-fields con la CRON_SECRET, o
# usa el botón "Diagnóstico de campos SF" en /admin.

# ── Geocodificación (mapa) ──
# Para direcciones que no nombran la localidad/ciudad, el sync usa Nominatim
# (OpenStreetMap) y guarda el resultado en la tabla `geocache` (ver schema.sql).
# GEOCODER_BUDGET = nº de direcciones NUEVAS a geocodificar por corrida (el resto
# sale de caché). Cada llamada espera ~1.1s. DEFAULT 0 = el sync NO llama a la red
# (termina rápido, ideal para Vercel Hobby/10s) y el navegador ubica con
# coordenadas/localidad/ciudad. Súbelo (p.ej. 45) solo con maxDuration alto (Pro).
GEOCODER_BUDGET=0
GEOCODER_UA=helpdesk-monitor/1.0 (tu-correo@dominio.com)

# ── Supabase ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=                     # service_role (solo servidor: sync/ingesta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon (cliente/navegador)

# ── Sync automático ──
CRON_SECRET=                             # protege /api/sync; el cron de Vercel lo envía como Bearer
